# Chave da API Runway (crie em https://dev.runwayml.com → API Keys).
# Copie este arquivo para .env — o .env é ignorado pelo git.
RUNWAYML_API_SECRET=key_xxxxxxxxxxxxxxxx

# Teto de créditos por geração quando --budget não é passado (1 crédito = US$ 0,01).
RUNWAY_DEFAULT_BUDGET=50

# Opcional: 'debug' loga toda requisição HTTP.
# RUNWAYML_LOG=warn
